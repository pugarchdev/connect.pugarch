# ================================
# BACKEND ENVIRONMENT VARIABLES
# ================================

# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:5001

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Redis Configuration
REDIS_TLS=false
REDIS_PREFIX=
REDIS_DB=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=

# JWT Authentication
JWT_SECRET=replace_with_jwt_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_KEY_FILE_PATH=
GCP_SERVICE_ACCOUNT_JSON=
GCS_BUCKET_NAME=
GCS_PUBLIC_READ=true

# Email / SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Government Digital Portal

# WhatsApp Template Overrides (Optional)
WHATSAPP_GRIEVANCE_CREATED_ADMIN_TEMPLATE=grievance_received_admin_v2
WHATSAPP_GRIEVANCE_TEMPLATE_LANGUAGE=en
WHATSAPP_PASSWORD_RESET_OTP_TEMPLATE=number_admin_v1_
WHATSAPP_PASSWORD_RESET_OTP_TEMPLATE_LANGUAGE=en

# Voice Hub (AI Voice Call & IVR)
VOICE_HUB_ENABLED=false
VOICE_HUB_BASE_URL=https://your-voice-hub-service.example.com
VOICE_HUB_API_KEY=vh_portal_replace_with_api_key
VOICE_HUB_CALLBACK_SECRET=replace_with_portal_callback_secret
VOICE_HUB_CALLBACK_URL=https://your-sahaj-backend.example.com/api/webhook/voice-hub
VOICE_HUB_TIMEOUT_MS=5000
